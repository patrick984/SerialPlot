<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SerialPlot.ViewModels"
        xmlns:views="using:SerialPlot.Views"
        xmlns:sp="using:ScottPlot.Avalonia"
        x:Class="SerialPlot.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Title="SerialPlot">
  <Window.Resources>
    <views:TraceBrushBindingConverter x:Key="TraceBrushBindingConverter"/>
    <views:CheckedTraceBrushConverter x:Key="CheckedTraceBrushConverter"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinWidth" Value="78"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,280">
    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"/>
        <Button Content="Clear" Command="{Binding ClearCommand}"/>
        <CheckBox Content="X Auto" IsChecked="{Binding AutoScaleX}" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding XAutoscaleModeOptions}"
                  SelectedItem="{Binding SelectedXAutoscaleModeOption}"
                  Width="180">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:XAutoscaleModeOption">
              <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Content="Y Left Auto" IsChecked="{Binding AutoScaleLeftY}" VerticalAlignment="Center"/>
        <CheckBox Content="Y Right Auto" IsChecked="{Binding AutoScaleRightY}" VerticalAlignment="Center"/>
        <Button Content="Export">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Save CSV" Click="SaveCsvClicked"/>
              <MenuItem Header="Export PNG" Click="ExportPngClicked"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Content="Sources" Click="ManageSourcesClicked"/>
        <Button Content="Settings" Click="SettingsClicked"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="0">
      <sp:AvaPlot x:Name="Plot"/>
      <Canvas x:Name="CursorOverlay" IsHitTestVisible="False">
        <Ellipse x:Name="CursorMarker"
                 Width="10"
                 Height="10"
                 Fill="#FFFFFFFF"
                 Stroke="#222222"
                 StrokeThickness="1.5"
                 IsVisible="False"/>
        <Border x:Name="CursorLabel"
                Background="#E6222222"
                BorderBrush="#FF222222"
                BorderThickness="2"
                CornerRadius="4"
                Padding="6,4"
                IsVisible="False">
          <TextBlock x:Name="CursorLabelText"
                     Foreground="White"
                     FontSize="12"/>
        </Border>
      </Canvas>
    </Grid>

    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="X channel" Classes="section"/>
          <ComboBox ItemsSource="{Binding Sources}"
                    SelectedItem="{Binding SelectedSource}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InputSourceViewModel">
                <TextBlock Text="{Binding DisplayName}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Source X channel" Classes="section"/>
          <ComboBox ItemsSource="{Binding Channels}"
                    SelectedItem="{Binding SelectedXChannel}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelViewModel">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Channels" Classes="section"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0"
                Margin="0,8,0,0">
          <TextBlock Text="{Binding Status}"
                     TextWrapping="Wrap"
                     TextAlignment="Right"
                     HorizontalAlignment="Stretch"/>
        </Border>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Channels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,4" ColumnSpacing="4">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="L" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                      <MultiBinding Converter="{StaticResource CheckedTraceBrushConverter}">
                        <Binding Path="IsSelectedLeft"/>
                        <Binding Path="LeftTraceBrush"/>
                      </MultiBinding>
                    </TextBlock.Foreground>
                  </TextBlock>
                  <CheckBox Grid.Column="2"
                            IsChecked="{Binding IsSelectedLeft}"
                            IsEnabled="{Binding CanBeY}"
                            VerticalAlignment="Center">
                    <CheckBox.BorderBrush>
                      <MultiBinding Converter="{StaticResource CheckedTraceBrushConverter}">
                        <Binding Path="IsSelectedLeft"/>
                        <Binding Path="LeftTraceBrush"/>
                      </MultiBinding>
                    </CheckBox.BorderBrush>
                    <CheckBox.Foreground>
                      <MultiBinding Converter="{StaticResource CheckedTraceBrushConverter}">
                        <Binding Path="IsSelectedLeft"/>
                        <Binding Path="LeftTraceBrush"/>
                      </MultiBinding>
                    </CheckBox.Foreground>
                  </CheckBox>
                  <TextBlock Grid.Column="3" Text="R" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                      <MultiBinding Converter="{StaticResource CheckedTraceBrushConverter}">
                        <Binding Path="IsSelectedRight"/>
                        <Binding Path="RightTraceBrush"/>
                      </MultiBinding>
                    </TextBlock.Foreground>
                  </TextBlock>
                  <CheckBox Grid.Column="4"
                            IsChecked="{Binding IsSelectedRight}"
                            IsEnabled="{Binding CanBeY}"
                            VerticalAlignment="Center">
                    <CheckBox.BorderBrush>
                      <MultiBinding Converter="{StaticResource CheckedTraceBrushConverter}">
                        <Binding Path="IsSelectedRight"/>
                        <Binding Path="RightTraceBrush"/>
                      </MultiBinding>
                    </CheckBox.BorderBrush>
                    <CheckBox.Foreground>
                      <MultiBinding Converter="{StaticResource CheckedTraceBrushConverter}">
                        <Binding Path="IsSelectedRight"/>
                        <Binding Path="RightTraceBrush"/>
                      </MultiBinding>
                    </CheckBox.Foreground>
                  </CheckBox>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="2"
            Grid.ColumnSpan="2"
            IsVisible="{Binding HasError}"
            Background="#611F1F"
            Padding="12">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
